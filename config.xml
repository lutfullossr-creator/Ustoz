<?xml version='1.0' encoding='utf-8'?>
<widget id="uz.lugat.daftari" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Lug'at daftari</name>
    <description>Oflayn lug'at va mashqlar</description>
    <author email="you@example.com">Siz</author>
    <content src="index.html" />
    <allow-navigation href="*" />
    <allow-intent href="*" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarBackgroundColor" value="#0b3fa8" />
